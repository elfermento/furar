#
# Copia este ficheiro a .env (nunca o subas ao repositorio).
# - Local (perfís dev e full): podes deixalo así; os baleiros usan valores de demo.
# - Produción (compose.prod.yaml): scripts/instalar.sh escribe o .env a partir deste ficheiro.
#   Enche todos os marcados [prod]: os que pregunta (dominio, correo de administración e SMTP), os
#   segredos (xéraos con openssl) e os da release (furar-<versión>.env). O resto ten valores por
#   defecto seguros; cambialos é opcional (docs/instalacion.md §4).

# --- URL público --------------------------------------------------------------
# [prod] URL co que entra a veciñanza, sen barra final (p. ex. https://reservas.concello.gal).
# Local full: http://localhost:8080 (por defecto). O perfil dev usa sempre http://localhost:4200.
FURAR_PUBLIC_URL=
# [prod] Correo da persoa que administrará a plataforma: a conta que entre con este correo,
# verificado, pasa a ser a administración mentres aínda non hai ningunha (ADR-0028). Despois,
# cambialo non fai nada. Nunca se mostra na web. instalar.sh pregúntao.
FURAR_ADMIN_EMAIL=
# Idiomas que todo concello ten que ofrecer, separados por comas (gl, es); baleiro = ningún.
FURAR_REQUIRED_LANGUAGES=gl

# --- Versión publicada (só produción) -----------------------------------------
# [prod] Os cinco valores do ficheiro furar-<versión>.env da release (instalar.sh cópiaos).
# FURAR_REGISTRY é o rexistro de contedores onde se publicou a versión: o das releases de Furar
# é ghcr.io/elfermento; outro, se o concello ou a Deputación constrúen as súas imaxes
# (docs/instalacion.md §11). Sen valor por defecto: produción non arrinca sen el.
FURAR_REGISTRY=
FURAR_VERSION=
FURAR_API_DIGEST=
FURAR_WEB_DIGEST=
FURAR_KEYCLOAK_DIGEST=

# --- Base de datos ------------------------------------------------------------
# Tres roles distintos (ADR-0015). Só se aplican ao crear o volume da base por primeira vez.
# instalar.sh xera estes catro contrasinais e os segredos de Keycloak e da invitación de abaixo;
# se volve escribir o .env, conserva os que xa había.
# [prod] Superusuario "postgres": só para o arranque inicial, copias e restauracións.
POSTGRES_PASSWORD=
# [prod] Rol "furar_owner", dono do esquema: só o usa o servizo migrate (a API non o recibe).
FURAR_DB_OWNER_PASSWORD=
# [prod] Rol "furar_app", o da API: só le e escribe datos (sen DDL nin superusuario).
FURAR_DB_PASSWORD=
# [prod] Contrasinal do usuario "keycloak" de PostgreSQL.
KC_DB_PASSWORD=

# --- Keycloak -----------------------------------------------------------------
# [prod] Administración inicial de Keycloak (consola só polo túnel SSH en http://localhost:8082/auth/admin; desde <FURAR_PUBLIC_URL> dá 403).
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# [prod] Segredo compartido entre a API e Keycloak: asina a proba da ligazón da invitación do
# persoal, coa que a conta nova nace co correo verificado (ADR-0027). Aleatorio e de 32 caracteres
# ou máis; o mesmo valor serve aos dous servizos. Xérao con: openssl rand -base64 48
FURAR_INVITATION_PROOF_SECRET=

# --- Correo -------------------------------------------------------------------
# [prod] Servidor SMTP do concello: correos de Keycloak (verificación, contrasinal) e das reservas
# (confirmada, cambiada, cancelada). Local: Mailpit (http://localhost:8025). FURAR_SMTP_FROM é o
# enderezo do remitente; o nome visible é o do concello. instalar.sh pregunta estes cinco e o
# cifrado, e envía un correo de proba (docs/instalacion.md §2).
FURAR_SMTP_HOST=
FURAR_SMTP_PORT=
FURAR_SMTP_FROM=
FURAR_SMTP_USER=
FURAR_SMTP_PASSWORD=
# Cifrado (instalar.sh pregúntao): STARTTLS no 587 (por defecto, STARTTLS=true e SSL=false),
# SSL/TLS no 465 (STARTTLS=false e SSL=true) ou sen cifrar, só cun servidor interno (os dous false).
FURAR_SMTP_STARTTLS=
FURAR_SMTP_SSL=
# Autenticación SMTP (por defecto true; instalar.sh pon false se non hai usuario).
FURAR_SMTP_AUTH=

# --- Protección de datos (RGPD art. 13, ADR-0017) ----------------------------
# O responsable, o DPD, os dereitos e o encargado non van aquí: son datos legais de cada concello,
# que se enchen na web (Datos do concello → Legal) e saen na súa páxina «Privacidade» e na frase do
# rexistro de Keycloak (revisión do 2026-11-03).
# Rexistro de actividade (ADR-0020, LOPDGDD art. 32), ISO 8601. Cada evento vese FURAR_AUDIT_VISIBLE,
# queda bloqueado ata FURAR_AUDIT_RETENTION (só o xestor o exporta cun motivo) e bórrase. O correo e
# o nome do persoal desactivado seguen os mesmos prazos desde a desactivación (ADR-0027). RETENTION: polo
# menos P1Y e máis ca VISIBLE; os 3 anos son a prescrición das faltas: cámbiao só co DPD.
FURAR_AUDIT_VISIBLE=P1Y
FURAR_AUDIT_RETENTION=P3Y

# --- Seguridade --------------------------------------------------------------
# [prod] Rangos de IP que poden abrir a administración de Keycloak (/auth/admin e o realm
# master) polo URL público, separados por espazos. Recomendado: 127.0.0.1/32 (pechado) e
# administrar polo túnel SSH: ssh -L 8082:127.0.0.1:8082 servidor → http://localhost:8082/auth/admin
# (instalar.sh pon 127.0.0.1/32).
# Se abres IPs concretas (p. ex. 192.0.2.10/32), nunca 172.16.0.0/12 (docs/instalacion.md §4).
# Local (baleiro): só redes privadas e loopback.
FURAR_ADMIN_IPS=

# --- Copias de seguridade (scripts/copia.sh) -----------------------------------
# Recomendado en produción: chave PÚBLICA de age (age1…) para cifrar as copias. A privada,
# fóra do servidor (docs/instalacion.md §6). Baleiro = copias sen cifrar.
FURAR_COPIAS_AGE_DESTINATARIO=
# Cantas copias conservar no servidor (copia.sh: baleiro ou 0 = non borrar ningunha;
# copia-diaria.sh: baleiro = 14).
FURAR_COPIAS_CONSERVAR=
# copia-diaria.sh (cron): destino de rclone (p. ex. copias-concello:furar), días que se
# conservan alí (baleiro = 30; 0 = non borrar) e URL opcional dun comprobador de tarefas
# (GET ao rematar, <URL>/fail se falla).
FURAR_COPIAS_DESTINO=
FURAR_COPIAS_DIAS_DESTINO=
FURAR_COPIAS_PING_URL=

# --- Mapa e enderezos (ADR-0023) -----------------------------------------------
# Mapa das instalacións. Por defecto (baleiro), o Mapa base do IGN (público, sen clave, CC BY 4.0)
# a través de Caddy, sen ningún dato da persoa: non hai que poñer nada (docs/instalacion.md §13).
# off = sen mapa (a web mostra só o enderezo; Caddy non sae a Internet polas teselas).
FURAR_MAP=
# Avanzado: outro servidor de teselas PNG de 256 px en Web Mercator. Esquema e host
# (baleiro = https://www.ign.es) e plantilla do camiño e da query con {z}, {x} e {y}, sen espazos
# (p. ex. /mapa/{z}/{x}/{y}.png; baleira = a do Mapa base do IGN).
FURAR_MAP_TILES_UPSTREAM=
FURAR_MAP_TILES_TEMPLATE=
# Recoñecemento que pide a licenza dos datos do mapa, sempre á vista, e a súa ligazón.
# Baleiro = o do IGN: «CC BY 4.0 scne.es» e https://www.scne.es. Cámbiao só con outro servidor.
FURAR_MAP_ATTRIBUTION=
FURAR_MAP_ATTRIBUTION_URL=
# Busca de enderezos: cartociudad (por defecto; a API consulta www.cartociudad.es) ou fixed
# (só os enderezos gardados de Narón e Ferrol, sen saír a Internet).
FURAR_GEOCODER=
# Proxy saínte corporativo, se o servidor non sae directo a Internet (p. ex.
# http://proxy.concello.local:3128). Úsano a API (CartoCiudad) e Caddy (teselas e Let's Encrypt).
FURAR_HTTP_PROXY=

# --- Código fonte (EUPL-1.2 art. 5) -------------------------------------------
# Repositorio ao que leva «Código fonte» no pé da web. Por defecto, o de Furar
# (https://github.com/elfermento/furar).
# Se o concello modifica Furar, ten que poñer aquí o repositorio coas súas modificacións.
FURAR_SOURCE_URL=

# --- Produción: usar compose.prod.yaml sen escribir -f -------------------------
# Descomenta no servidor (NON en local): entón `docker compose up -d --wait` xa usa produción.
# COMPOSE_FILE=compose.yaml:compose.prod.yaml

# --- Portos -------------------------------------------------------------------
# Porto HTTP de Caddy: perfil full 8080, produción 80. HTTPS en produción: 443.
# En produción non os cambies (Let's Encrypt valida polo 80); só para probas (D48).
FURAR_HTTP_PORT=
FURAR_HTTPS_PORT=
# Perfil full: en que interface escoita Caddy. Por defecto 127.0.0.1 (só este equipo): leva
# usuarios e contrasinais de demo públicos. 0.0.0.0 ábreo á rede local; pon entón tamén
# FURAR_ADMIN_IPS=127.0.0.1/32 (en macOS con Colima nin iso pecha a consola). Produción non o usa.
FURAR_HTTP_BIND=
# Porto local (127.0.0.1) da consola de Keycloak en produción (por defecto 8082).
FURAR_KC_ADMIN_PORT=
