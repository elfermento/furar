{
  "accessTokenLifespan": 300,
  "accountTheme": "furar",
  "adminEventsDetailsEnabled": false,
  "adminEventsEnabled": true,
  "attributes": {
    "actionTokenGeneratedByUserLifespan.reset-credentials": "1800",
    "actionTokenGeneratedByUserLifespan.verify-email": "1800",
    "adminEventsExpiration": "7776000"
  },
  "authenticationFlows": [
    {
      "alias": "furar-registration",
      "authenticationExecutions": [
        {
          "authenticator": "registration-page-form",
          "authenticatorFlow": true,
          "flowAlias": "furar-registration-form",
          "priority": 10,
          "requirement": "REQUIRED",
          "userSetupAllowed": false
        }
      ],
      "builtIn": false,
      "description": "Rexistro de Furar: o de Keycloak co contrasinal no formulario e a invitación do persoal que verifica o correo (ADR-0027)",
      "providerId": "basic-flow",
      "topLevel": true
    },
    {
      "alias": "furar-registration-form",
      "authenticationExecutions": [
        {
          "authenticator": "registration-user-creation",
          "authenticatorFlow": false,
          "priority": 20,
          "requirement": "REQUIRED",
          "userSetupAllowed": false
        },
        {
          "authenticator": "registration-password-action",
          "authenticatorConfig": "furar-password-on-form",
          "authenticatorFlow": false,
          "priority": 50,
          "requirement": "REQUIRED",
          "userSetupAllowed": false
        },
        {
          "authenticator": "furar-invitation-email",
          "authenticatorFlow": false,
          "priority": 55,
          "requirement": "REQUIRED",
          "userSetupAllowed": false
        }
      ],
      "builtIn": false,
      "description": "Formulario de rexistro de Furar",
      "providerId": "form-flow",
      "topLevel": false
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "furar-password-on-form",
      "config": {
        "always_set_password_on_register_form": "true"
      }
    }
  ],
  "browserFlow": "browser",
  "bruteForceProtected": true,
  "bruteForceStrategy": "MULTIPLE",
  "clients": [
    {
      "bearerOnly": true,
      "clientId": "furar-api",
      "description": "Servidor de recursos: só valida tokens. Sen roles: os permisos (administración da plataforma e persoal de cada concello) saen da base de datos de Furar (ADR-0027, ADR-0028)",
      "directAccessGrantsEnabled": false,
      "enabled": true,
      "implicitFlowEnabled": false,
      "name": "Furar (API)",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false
    },
    {
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/##http://localhost:8080/"
      },
      "baseUrl": "/",
      "clientId": "furar-web",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "basic"
      ],
      "description": "Demo: admite a web en ng serve (4200) e en compose full (8080)",
      "directAccessGrantsEnabled": false,
      "enabled": true,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "implicitFlowEnabled": false,
      "name": "Reservas deportivas",
      "optionalClientScopes": [],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.client.audience": "furar-api",
            "introspection.token.claim": "true"
          },
          "name": "audience-furar-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper"
        }
      ],
      "publicClient": true,
      "redirectUris": [
        "http://localhost:4200/",
        "http://localhost:8080/"
      ],
      "rootUrl": "",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "webOrigins": [
        "+"
      ]
    },
    {
      "clientId": "furar-e2e",
      "description": "Só en dev/full: permite pedir tokens con usuario e contrasinal para D33 e o e2e. Nunca en produción.",
      "directAccessGrantsEnabled": true,
      "enabled": true,
      "fullScopeAllowed": true,
      "implicitFlowEnabled": false,
      "name": "Furar (probas automáticas, só demo)",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.client.audience": "furar-api",
            "introspection.token.claim": "true"
          },
          "name": "audience-furar-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper"
        }
      ],
      "publicClient": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false
    }
  ],
  "defaultLocale": "gl",
  "displayName": "Reservas deportivas",
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "emailTheme": "furar",
  "enabled": true,
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "failureFactor": 5,
  "identityProviderMappers": [
    {
      "config": {
        "attribute.name": "email",
        "syncMode": "INHERIT",
        "user.attribute": "email"
      },
      "identityProviderAlias": "clave-simulada",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "name": "email"
    },
    {
      "config": {
        "attribute.name": "firstName",
        "syncMode": "INHERIT",
        "user.attribute": "firstName"
      },
      "identityProviderAlias": "clave-simulada",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "name": "firstName"
    },
    {
      "config": {
        "attribute.name": "lastName",
        "syncMode": "INHERIT",
        "user.attribute": "lastName"
      },
      "identityProviderAlias": "clave-simulada",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "name": "lastName"
    },
    {
      "config": {
        "syncMode": "INHERIT",
        "template": "${ALIAS}.${NAMEID}"
      },
      "identityProviderAlias": "clave-simulada",
      "identityProviderMapper": "saml-username-idp-mapper",
      "name": "username opaco"
    }
  ],
  "identityProviders": [
    {
      "addReadTokenRoleOnCreate": false,
      "alias": "clave-simulada",
      "config": {
        "allowCreate": "true",
        "entityId": "${FURAR_PUBLIC_URL}/auth/realms/furar",
        "forceAuthn": "false",
        "guiOrder": "1",
        "idpEntityId": "${FURAR_PUBLIC_URL}/auth/realms/clave-simulada",
        "metadataDescriptorUrl": "http://localhost:8082/auth/realms/clave-simulada/protocol/saml/descriptor",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
        "postBindingAuthnRequest": "true",
        "postBindingLogout": "true",
        "postBindingResponse": "true",
        "principalType": "SUBJECT",
        "signatureAlgorithm": "RSA_SHA256",
        "singleLogoutServiceUrl": "${FURAR_PUBLIC_URL}/auth/realms/clave-simulada/protocol/saml",
        "singleSignOnServiceUrl": "${FURAR_PUBLIC_URL}/auth/realms/clave-simulada/protocol/saml",
        "syncMode": "FORCE",
        "useMetadataDescriptorUrl": "true",
        "validateSignature": "true",
        "wantAssertionsEncrypted": "false",
        "wantAssertionsSigned": "true",
        "wantAuthnRequestsSigned": "false"
      },
      "displayName": "Cl@ve (simulada, só demo)",
      "enabled": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "hideOnLogin": false,
      "linkOnly": false,
      "providerId": "saml",
      "storeToken": false,
      "trustEmail": true
    }
  ],
  "internationalizationEnabled": true,
  "loginTheme": "furar",
  "loginWithEmailAllowed": true,
  "maxDeltaTimeSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "maxTemporaryLockouts": 0,
