  "clients": [
    {
      "clientId": "furar-api",
      "name": "Furar (API)",
      "description": "Servidor de recursos: só valida tokens. Sen roles: os permisos (administración da plataforma e persoal de cada concello) saen da base de datos de Furar (ADR-0027, ADR-0028)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "furar-web",
      "name": "Reservas deportivas",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "rootUrl": "${FURAR_PUBLIC_URL}",
      "baseUrl": "/",
      "redirectUris": [
        "${FURAR_PUBLIC_URL}/"
      ],
      "webOrigins": [
        "+"
      ],
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "basic"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${FURAR_PUBLIC_URL}/"
      },
      "protocolMappers": [
        {
          "name": "audience-furar-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "furar-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "revokeRefreshToken": true,
