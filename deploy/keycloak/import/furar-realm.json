{
  "realm": "furar",
  "displayName": "Reservas deportivas",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "bruteForceStrategy": "MULTIPLE",
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 0,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 900,
  "maxTemporaryLockouts": 0,
  "passwordPolicy": "length(10) and digits(1) and notUsername and notEmail and passwordBlacklist(furar-contrasinais-comuns.txt) and maxLength(128)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "gl",
    "es"
  ],
  "defaultLocale": "gl",
  "loginTheme": "furar",
  "accountTheme": "furar",
  "emailTheme": "furar",
  "smtpServer": {
    "host": "${FURAR_SMTP_HOST:mailpit}",
    "port": "${FURAR_SMTP_PORT:1025}",
    "from": "${FURAR_SMTP_FROM:furar@localhost}",
    "fromDisplayName": "Reservas deportivas",
    "ssl": "${FURAR_SMTP_SSL:false}",
    "starttls": "${FURAR_SMTP_STARTTLS:false}",
    "auth": "${FURAR_SMTP_AUTH:false}",
    "user": "${FURAR_SMTP_USER:}",
    "password": "${FURAR_SMTP_PASSWORD:}"
  },
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "attributes": {
    "adminEventsExpiration": "7776000",
    "actionTokenGeneratedByUserLifespan.verify-email": "1800",
    "actionTokenGeneratedByUserLifespan.reset-credentials": "1800"
  },
  "browserFlow": "furar-browser",
  "registrationFlow": "furar-registration",
  "resetCredentialsFlow": "furar-reset-credentials",
  "authenticationFlows": [
    {
      "alias": "furar-browser",
      "description": "Acceso de Furar: o browser de Keycloak e, para o persoal e a plataforma, o segundo factor: a aplicación de autenticación ou o código por correo (ADR-0029)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "furar-browser forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "furar-browser forms",
      "description": "Correo e contrasinal; despois, o segundo factor se a conta o precisa",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "furar-browser second factor",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "furar-browser second factor",
      "description": "Persoal e plataforma (pregúntase á API de Furar): o código do método que configurou ou, se aínda non ten ningún, escollelo e dalo de alta",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "furar-second-factor",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "furar-second-factor-setup",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "furar-browser app",
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false
