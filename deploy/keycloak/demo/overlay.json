  "webClient": {
    "description": "Demo: admite a web en ng serve (4200) e en compose full (8080)",
    "rootUrl": "",
    "baseUrl": "/",
    "redirectUris": [
      "http://localhost:4200/",
      "http://localhost:8080/"
    ],
    "attributes": {
      "pkce.code.challenge.method": "S256",
      "post.logout.redirect.uris": "http://localhost:4200/##http://localhost:8080/"
    }
  },
