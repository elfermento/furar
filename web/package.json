{
  "name": "furar-web",
  "version": "0.1.0",
  "private": true,
  "license": "EUPL-1.2",
  "description": "Web de Furar: reserva de instalacións deportivas municipais",
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "ng": "ng",
    "api:generate": "ng-openapi-gen --config ng-openapi-gen.json",
    "prestart": "npm run api:generate",
    "start": "ng serve",
    "prebuild": "npm run api:generate",
    "build": "ng build",
    "postbuild": "node scripts/third-party-notices.mjs && node scripts/ngsw-check.mjs",
    "pretest": "npm run api:generate",
    "test": "ng test",
    "prelint": "npm run api:generate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node --test scripts/template-text.test.mjs && node scripts/i18n-check.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/service-worker": "22.2.3",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@jsverse/transloco": "8.4.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "echarts": "6.1.0",
    "leaflet": "1.9.4",
    "oidc-client-ts": "3.5.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "angular-eslint": "22.6.0",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "license-checker-rseidelsohn": "5.0.1",
    "ng-openapi-gen": "1.1.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "linkifyjs": "4.3.3",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6"
  }
}
