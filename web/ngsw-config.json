{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/auth/**",
    "!/api/**",
    "!/healthz",
    "!/codigo-fonte"
  ],
  "assetGroups": [
    {
      "name": "lazy",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/echarts-setup-*.js",
          "/rich-text-setup-*.js",
          "/indicators.page-*.js",
          "/indicadores.css",
          "/facility-detail.page-*.js",
          "/facility-list.page-*.js",
          "/facility.routes-*.js",
          "/manage-bookings.page-*.js",
          "/bookings-calendar.page-*.js",
          "/custom-field-edit.page-*.js",
          "/custom-fields-admin.page-*.js",
          "/customfields.routes-*.js",
          "/municipality-section.routes-*.js",
          "/municipality-section.page-*.js",
          "/general.tab-*.js",
          "/appearance.tab-*.js",
          "/service.tab-*.js",
          "/legal.tab-*.js",
          "/municipality-create.page-*.js",
          "/platform.routes-*.js",
          "/activity.page-*.js",
          "/xestion.css"
        ]
      }
    },
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.svg", "/index.html", "/manifest.json", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/media/**", "/icons/**", "/**/*.(svg|woff2|png|webp)"]
      }
    }
  ],
  "dataGroups": []
}
