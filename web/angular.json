{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "furar-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "changeDetection": "OnPush",
          "style": "none",
          "prefix": "furar"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "furar",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/furar-web",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": [
              "src/styles.css",
              { "input": "src/styles/vendor/leaflet.css", "bundleName": "leaflet", "inject": false },
              { "input": "src/styles/xestion.css", "bundleName": "xestion", "inject": false },
              { "input": "src/styles/reservas.css", "bundleName": "reservas", "inject": false },
              { "input": "src/styles/indicadores.css", "bundleName": "indicadores", "inject": false }
            ],
            "security": { "autoCsp": true }
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "460kB", "maximumError": "500kB" },
                { "type": "anyComponentStyle", "maximumWarning": "4kB", "maximumError": "8kB" }
              ],
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": false
              },
              "outputHashing": "all",
              "namedChunks": true,
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": { "buildTarget": "furar-web:build:production" },
            "development": { "buildTarget": "furar-web:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "setupFiles": ["src/test-setup.ts"],
            "coverageInclude": ["src/app/**/*.ts"],
            "coverageExclude": ["src/app/api/**", "src/app/**/*.spec.ts"],
            "coverageReporters": ["text-summary", "html", "lcovonly"],
            "coverageThresholds": { "statements": 90, "branches": 87, "functions": 81, "lines": 90 }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html", "e2e/**/*.ts"]
          }
        }
      }
    }
  }
}
